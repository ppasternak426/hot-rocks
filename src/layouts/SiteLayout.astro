---
import "../styles/global.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigation = [
  { href: "/", label: "Home" },
  { href: "/sessions", label: "Sessions" },
  { href: "/events", label: "Events" },
  { href: "/first-visit", label: "First Visit & FAQ" },
  { href: "/about", label: "About" },
  { href: "/visit", label: "Visit & Contact" },
  { href: "/book", label: "Book now" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | The Hot Rocks Sauna</title>
  </head>
  <body class="text-slate-900">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:p-4">
      Skip to content
    </a>
    <header class="border-b border-slate-300">
      <div class="mx-auto max-w-5xl px-5 py-5">
        <a href="/" class="font-bold">
          The Hot Rocks Sauna
        </a>
        <nav aria-label="Main navigation" class="mt-4">
          <ul class="flex flex-wrap gap-x-5 gap-y-3">
            {navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                  class="underline underline-offset-4"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="mx-auto min-h-80 max-w-5xl px-5 py-12">
      <slot />
    </main>
    <footer class="border-t border-slate-300">
      <nav aria-label="Footer navigation" class="mx-auto max-w-5xl px-5 py-6">
        <ul class="flex flex-wrap gap-x-5 gap-y-3">
          <li>
            <a href="/gallery" class="underline">
              Gallery
            </a>
          </li>
          <li>
            <a href="/gift-vouchers" class="underline">
              Gift vouchers
            </a>
          </li>
          <li>
            <a href="/terms" class="underline">
              Terms &amp; Conditions
            </a>
          </li>
          <li>
            <a href="/privacy" class="underline">
              Privacy Policy
            </a>
          </li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
