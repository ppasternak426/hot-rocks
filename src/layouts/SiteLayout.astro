---
import { siteBase, sitePath } from "../data/site-path";
import { getImage } from "astro:assets";
import headingFontUrl from "../assets/fonts/cormorant-garamond.woff2?url";
import bodyFontUrl from "../assets/fonts/dm-sans.woff2?url";
import logo from "../assets/home/hot-rocks-logo.webp";
import sharingPhoto from "../assets/home/lough-neagh-sauna.jpg";
import PageTransitions from "../components/PageTransitions.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { liveSite } from "../data/sauna";
import { getVisitSettings } from "../data/site-content";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { contactEmail, phoneInternational, postalAddress, socialProfiles } =
  await getVisitSettings();
const currentPath =
  Astro.url.pathname.slice(siteBase.length).replace(/\/$/, "") || "/";
const siteName = "The Hot Rocks Sauna";
const pageTitle = `${title} | ${siteName}`;
const homeUrl = new URL(sitePath("/"), Astro.site ?? liveSite);
const pagePath = currentPath === "/" ? "/" : `${currentPath}/`;
const canonicalUrl = new URL(
  sitePath(currentPath === "/404" ? "/404.html" : pagePath),
  homeUrl,
).href;
const sharingImage = await getImage({
  src: sharingPhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
});
const sharingImageUrl = new URL(sharingImage.src, homeUrl).href;
const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": new URL("#sauna", homeUrl).href,
  name: siteName,
  url: homeUrl.href,
  image: sharingImageUrl,
  logo: new URL(logo.src, homeUrl).href,
  telephone: phoneInternational,
  email: contactEmail,
  address: { "@type": "PostalAddress", ...postalAddress },
  sameAs: socialProfiles.map(({ href }) => href),
};
const navigation = [
  { href: "/sessions/", label: "Sessions" },
  { href: "/first-visit/", label: "First visit" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/visit/", label: "Find us" },
];
const footerLinks = [
  { href: "/about/", label: "About" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/events/", label: "Events" },
  { href: "/benefits/", label: "Sauna benefits" },
  { href: "/gift-vouchers/", label: "Gift vouchers" },
];
const legalLinks = [
  { href: "/terms/", label: "Terms & conditions" },
  { href: "/privacy/", label: "Privacy policy" },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2b1d17" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex || siteBase ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={sharingImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta
      property="og:image:width"
      content={String(sharingImage.attributes.width)}
    />
    <meta
      property="og:image:height"
      content={String(sharingImage.attributes.height)}
    />
    <meta
      property="og:image:alt"
      content="Inside The Hot Rocks Sauna, with wooden benches and a view of Lough Neagh"
    />
    {currentPath === "/" && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(business).replaceAll("<", "\\u003c")}
      />
    )}
    <link rel="icon" href={sitePath("/favicon.ico")} sizes="any" />
    <link rel="apple-touch-icon" href={sitePath("/apple-touch-icon.png")} />
    {(currentPath === "/" ||
      currentPath === "/sessions" ||
      currentPath === "/about") && (
      <link rel="preconnect" href="https://cdn.sanity.io" />
    )}
    {[headingFontUrl, bodyFontUrl].map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    ))}
    <PageTransitions />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <header
      class:list={["site-header", currentPath === "/" && "site-header-home"]}
    >
      <div class="wrap site-header-inner">
        <a
          href={sitePath("/")}
          class="site-logo"
          aria-label="The Hot Rocks Sauna home"
          aria-current={currentPath === "/" ? "page" : undefined}
        >
          <img src={logo.src} width="58" height="58" alt="" />
        </a>
        <nav class="site-nav site-header-nav" aria-label="Main navigation">
          <ul>
            {navigation.map(({ href, label }) => (
              <li>
                <a
                  href={sitePath(href)}
                  aria-current={
                    currentPath === href.slice(0, -1) ? "page" : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer-top">
          <a class="site-footer-name" href={sitePath("/")}>
            {siteName}
          </a>
          <a
            class="text-link"
            href={sitePath("/book/")}
            aria-current={currentPath === "/book" ? "page" : undefined}
          >
            Book a session
          </a>
        </div>
        <div class="site-footer-bottom">
          <nav class="site-nav site-footer-nav" aria-label="Explore Hot Rocks">
            <ul>
              {footerLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={sitePath(href)}
                    aria-current={
                      currentPath === href.slice(0, -1) ? "page" : undefined
                    }
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav class="site-nav site-footer-social" aria-label="Social media">
            <ul>
              {socialProfiles.map(({ href, label }) => (
                <li>
                  <a href={href} aria-label={label}>
                    <SocialIcon name={label} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <nav class="site-nav site-footer-legal" aria-label="Legal">
          <ul>
            {legalLinks.map(({ href, label }) => (
              <li>
                <a
                  href={sitePath(href)}
                  aria-current={
                    currentPath === href.slice(0, -1) ? "page" : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import "../scripts/scroll-reveal";
    </script>
  </body>
</html>
