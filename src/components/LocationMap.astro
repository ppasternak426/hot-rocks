---
import { sitePath } from "../data/site-path";
import { Image } from "astro:assets";
import sunset from "../assets/home/lough-neagh-sunset.jpeg";
import { getVisitSettings } from "../data/site-content";

interface Props {
  variant?: "visit" | "home-intro";
}

const { variant = "visit" } = Astro.props;
const home = variant === "home-intro";
const settings = await getVisitSettings();
---

<section
  id={home ? "visit" : undefined}
  class:list={["location-section panel", home && "location-section-home"]}
  aria-labelledby="location-title"
  tabindex="-1"
>
  {home && (
    <Image
      class="location-backdrop"
      src={sunset}
      alt=""
      widths={[960, 1280, 1600]}
      sizes="(max-width: 52rem) max(100vw, 78rem), 100vw"
      format="webp"
      quality={80}
    />
  )}
  <div class="wrap">
    <div
      class="location-heading"
      id={home ? "contact" : undefined}
      tabindex={home ? -1 : undefined}
    >
      <div>
        <h2 id="location-title">
          {home ? "Plan your visit" : settings.locationHeading}
        </h2>
        <p>{settings.locationNote}</p>
        {!home && (
          <>
            {settings.arrivalNotes && <p>{settings.arrivalNotes}</p>}
            {!settings.arrivalNotes && (
              <p>
                <a href="#contact">
                  Ask us about parking or changing facilities
                </a>
                .
              </p>
            )}
          </>
        )}
      </div>
      {home && (
        <div class="actions">
          <a class="button button-light" href={sitePath("/visit/")}>
            Find us
          </a>
          <a class="text-link" href={sitePath("/first-visit/")}>
            First visit
          </a>
          <a class="text-link" href={sitePath("/visit/#contact")}>
            Contact us
          </a>
        </div>
      )}
    </div>
    {!home && (
      <figure class="location-map">
        <img
          src={sitePath("/gawleys-gate-map.svg")}
          width="840"
          height="520"
          alt="The Hot Rocks Sauna is on the south-east shore of Lough Neagh at Gawley’s Gate, west of Belfast and Lisburn and north of Lurgan."
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          Map data from&nbsp;
          <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
          &nbsp;and &nbsp;
          <a href="https://www.naturalearthdata.com/about/">Natural Earth</a>.
        </figcaption>
      </figure>
    )}
  </div>
</section>

<style>
  .location-section-home {
    position: relative;
    isolation: isolate;
    padding-block-start: clamp(5.5rem, 23vw, 7.5rem);
    background: var(--espresso);
    color: var(--milk);
  }

  .location-backdrop,
  .location-section-home::after {
    position: absolute;
    inset: 0;
  }

  .location-backdrop {
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 44% 50%;
  }

  .location-section-home::after {
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(43 29 23 / 12%),
      rgb(43 29 23 / 79%) 21%,
      rgb(43 29 23 / 70%) 53%,
      rgb(43 29 23 / 24%)
    );
    content: "";
  }

  .location-section-home .location-heading p {
    color: var(--milk);
  }

  @media (min-width: 52rem) {
    .location-section-home {
      display: grid;
      align-items: center;
      min-block-size: clamp(32rem, 44vw, 42rem);
      padding-block: var(--panel-space);
    }

    .location-backdrop {
      object-position: center 54%;
    }

    .location-section-home::after {
      background: linear-gradient(
        96deg,
        rgb(43 29 23 / 88%),
        rgb(43 29 23 / 78%) 34%,
        rgb(43 29 23 / 19%) 80%
      );
    }

    .location-section-home .location-heading {
      display: grid;
      max-inline-size: 32rem;
      margin-block-end: 0;
    }
  }
</style>
