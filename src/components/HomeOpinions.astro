---
import { getFeaturedOpinions } from "../data/opinions";

const opinions = await getFeaturedOpinions();
const allSamples = opinions.every(({ isSample }) => isSample);
---

{opinions.length > 0 && (
  <section id="opinions" class="panel paper" aria-labelledby="opinions-title">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <h2 id="opinions-title">Featured opinions</h2>
          {allSamples && <p>Fictional examples of guest opinions.</p>}
        </div>
      </div>
      <div class="opinion-carousel" data-opinion-carousel>
        {opinions.length > 1 && (
          <button
            class="opinion-arrow opinion-arrow-previous"
            type="button"
            aria-label="Previous opinion"
            aria-controls="opinion-list"
            data-opinion-step="-1"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5m6-6-6 6 6 6" />
            </svg>
          </button>
        )}
        <div class="opinion-viewport">
          <ul id="opinion-list" class="opinion-grid" role="list">
            {opinions.map(({ title, quote, authorName, rating, isSample }) => (
              <li class="opinion-card" data-opinion-card>
                <figure>
                  {title && <h3>{title}</h3>}
                  {rating !== null && (
                    <div
                      class="opinion-rating"
                      role="img"
                      aria-label={`${rating} out of 5 stars`}
                    >
                      {[1, 2, 3, 4, 5].map((star) => (
                        <svg
                          viewBox="0 0 24 24"
                          width="16"
                          height="16"
                          fill={star <= rating ? "var(--honey)" : "none"}
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3L7 14.2 2 9.3l6.9-1z" />
                        </svg>
                      ))}
                    </div>
                  )}
                  {isSample && !allSamples && (
                    <p class="opinion-sample">Fictional example</p>
                  )}
                  <blockquote>
                    <p>“{quote}”</p>
                  </blockquote>
                  {authorName && <figcaption>{authorName}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </div>
        {opinions.length > 1 && (
          <button
            class="opinion-arrow opinion-arrow-next"
            type="button"
            aria-label="Next opinion"
            aria-controls="opinion-list"
            data-opinion-step="1"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </button>
        )}
      </div>
      <p class="sr-only" role="status" data-opinion-status></p>
    </div>
  </section>
)}

<script>
  const carousel = document.querySelector<HTMLElement>(
    "[data-opinion-carousel]",
  );
  const track = carousel?.querySelector<HTMLElement>(".opinion-grid");
  const status = carousel?.parentElement?.querySelector(
    "[data-opinion-status]",
  );
  const cards = Array.from(
    carousel?.querySelectorAll("[data-opinion-card]") ?? [],
  );
  const previous = carousel?.querySelector('[data-opinion-step="-1"]');
  const next = carousel?.querySelector('[data-opinion-step="1"]');

  if (carousel && track && status && previous && next && cards.length > 1) {
    const mobile = window.matchMedia("(width <= 44rem)");
    const desktop = window.matchMedia("(width >= 60rem)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let finishSlide: (() => void) | undefined;

    const update = (announce = false) => {
      const visible = desktop.matches ? 3 : mobile.matches ? 1 : 2;
      const canSlide = cards.length > visible;
      carousel.toggleAttribute("data-can-slide", canSlide);
      if (!canSlide) track.append(...cards);

      const orderedCards = Array.from(track.children);
      orderedCards.forEach((card, index) => {
        card.toggleAttribute("inert", index >= visible);
      });

      if (announce) {
        const positions = orderedCards
          .slice(0, visible)
          .map((card) => cards.indexOf(card) + 1);
        status.textContent =
          visible === 1
            ? `Opinion ${positions[0]} of ${cards.length}`
            : `Showing opinions ${positions.join(", ")} of ${cards.length}`;
      }
    };

    const slide = (forward: boolean) => {
      finishSlide?.();
      const first = track.firstElementChild;
      const last = track.lastElementChild;
      if (!first || !last || !carousel.hasAttribute("data-can-slide")) return;

      // Reuse the same cards. Moving back needs a card before the viewport
      // starts sliding, while moving forward can recycle the outgoing card.
      if (!forward) track.prepend(last);

      const shifted = "translateX(calc(-1 * var(--card-step)))";
      const animation = reducedMotion.matches
        ? undefined
        : track.animate(
            { transform: forward ? ["none", shifted] : [shifted, "none"] },
            {
              duration: 320,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)",
              fill: "both",
            },
          );
      const finish = () => {
        if (finishSlide !== finish) return;
        finishSlide = undefined;
        if (forward) track.append(first);
        animation?.cancel();
        update(true);
      };
      finishSlide = finish;

      if (animation) void animation.finished.then(finish, finish);
      else finish();
    };

    const onViewportChange = () => {
      finishSlide?.();
      update();
    };

    previous.addEventListener("click", () => slide(false));
    next.addEventListener("click", () => slide(true));
    mobile.addEventListener("change", onViewportChange);
    desktop.addEventListener("change", onViewportChange);
    reducedMotion.addEventListener("change", onViewportChange);
    update();
  }
</script>

<style>
  .opinion-grid {
    --visible-cards: 2;
    --card-gap: clamp(0.75rem, 2.4vw, 1.75rem);
    display: grid;
    grid-template-columns: repeat(var(--visible-cards), minmax(0, 1fr));
    gap: var(--card-gap);
  }

  .opinion-card h3 {
    margin-block-end: 0.65rem;
    color: var(--espresso);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }

  .opinion-grid > .opinion-card {
    max-inline-size: none;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--photo-radius);
    background: var(--milk);
    overflow-wrap: anywhere;
  }

  .opinion-rating {
    display: flex;
    gap: 0.2rem;
    margin-block-end: 0.75rem;
    color: var(--walnut);
  }

  .opinion-card blockquote {
    color: var(--espresso);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .opinion-card figcaption,
  .opinion-sample {
    color: var(--walnut);
    font-size: 0.875rem;
  }

  .opinion-card figcaption {
    margin-block-start: 0.75rem;
  }

  .opinion-sample {
    margin-block-end: 0.75rem;
    font-weight: 600;
  }

  .opinion-arrow {
    display: none;
  }

  [data-can-slide] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.375rem, 1.5vw, 1.25rem);
  }

  [data-can-slide] .opinion-viewport {
    overflow: clip;
  }

  [data-can-slide] .opinion-grid {
    --card-step: calc((100% + var(--card-gap)) / var(--visible-cards));
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: calc(var(--card-step) - var(--card-gap));
  }

  [data-can-slide] .opinion-arrow {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--milk);
    color: var(--espresso);
    cursor: pointer;
    touch-action: manipulation;
  }

  .opinion-arrow:is(:hover, :focus-visible) {
    border-color: var(--espresso);
  }

  @media (width >= 60rem) {
    .opinion-grid {
      --visible-cards: 3;
    }
  }

  @media (width <= 44rem) {
    .opinion-grid {
      --visible-cards: 1;
    }

    [data-can-slide] {
      margin-inline: calc(-1 * (var(--gutter) - 0.5rem));
    }
  }
</style>
