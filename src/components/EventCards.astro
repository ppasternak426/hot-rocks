---
import { sitePath } from "../data/site-path";
import { formatEventDate, type SaunaEvent } from "../data/events";
import FeatureCard from "./FeatureCard.astro";

interface Props {
  events: readonly SaunaEvent[];
  showPastStatus?: boolean;
}

const { events, showPastStatus = false } = Astro.props;
const now = Date.now();
---

<ul class="feature-grid" role="list">
  {events.map(({ slug, title, description, startsAt, image }) => (
    <FeatureCard
      href={sitePath(`/events/${slug}/`)}
      headingId={`event-card-${slug}`}
      title={title}
      description={description}
      image={image}
    >
      <time datetime={startsAt}>{formatEventDate(startsAt)}</time>
      {showPastStatus && Date.parse(startsAt) < now && <span>Past event</span>}
    </FeatureCard>
  ))}
</ul>
