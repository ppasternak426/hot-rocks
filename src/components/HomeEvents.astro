---
import { getFeaturedEvents } from "../data/events";
import EventCards from "./EventCards.astro";

const events = await getFeaturedEvents();
---

{events.length > 0 && (
  <section id="events" class="panel toast" aria-labelledby="home-events-title">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="home-events-title">Featured events</h2>
        <a class="text-link" href="/events/">
          See all events
        </a>
      </div>
      <EventCards events={events} />
    </div>
  </section>
)}
