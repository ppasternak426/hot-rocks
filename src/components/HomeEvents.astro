---
import { formatCompactEventDate, type SaunaEvent } from "../data/events";
import EventCards from "./EventCards.astro";

interface Props {
  events: readonly SaunaEvent[];
}

const { events } = Astro.props;
const now = Date.now();
---

{events.length > 0 && (
  <section id="events" aria-labelledby="home-events-title">
    <div class="section-heading">
      <h2 id="home-events-title">Featured events</h2>
      <a class="text-link" href="/events/">
        See all events
      </a>
    </div>
    <div class="home-event-cards">
      <EventCards events={events} showPastStatus />
    </div>
    <ul class="home-event-list ruled-list" role="list">
      {events.map(({ slug, title, startsAt }) => {
        const { day, time } = formatCompactEventDate(startsAt);
        return (
          <li>
            <a href={`/events/${slug}/`}>
              <time datetime={startsAt}>
                <span>{day}</span>
                <span>{time}</span>
              </time>
              <span class="home-event-name">
                {title}
                {Date.parse(startsAt) < now && <small>Past event</small>}
              </span>
              <span class="feature-card-arrow" aria-hidden="true"></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .home-event-list {
    display: none;
  }

  @media (width <= 42rem) {
    .home-event-cards {
      display: none;
    }

    .home-event-list {
      display: block;
    }

    .home-event-list > li {
      padding-block: 0;
    }

    .home-event-list a {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.85rem;
      min-block-size: 44px;
      padding-block: 0.8rem;
      text-decoration: none;
    }

    .home-event-list time,
    .home-event-list small {
      display: block;
      color: var(--walnut);
      font-size: 0.875rem;
    }

    .home-event-list time span {
      display: block;
    }

    .home-event-name {
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .home-event-list a:is(:hover, :focus-visible) .home-event-name {
      text-decoration: underline;
    }

    .home-event-list small {
      font-weight: 400;
    }

    .home-event-list .feature-card-arrow {
      margin: 0;
      color: currentColor;
    }
  }
</style>
