---
import { sitePath } from "../data/site-path";
import { saunaQuiz } from "../data/sauna-benefits";
---

<section
  id="sauna-quiz"
  class="sauna-quiz"
  aria-labelledby="quiz-title"
  tabindex="-1"
>
  <h2 id="quiz-title">The Hot Rocks Sauna Quiz</h2>

  <noscript>
    <p>
      The quiz needs JavaScript.{" "}
      <a href="#sauna-research">Read about the benefits.</a>
    </p>
  </noscript>
  <hot-rocks-quiz>
    {saunaQuiz.map((round, index) => (
      <div data-round hidden={index !== 0}>
        <form>
          <p class="quiz-progress">
            Question {index + 1} of {saunaQuiz.length}
          </p>
          <h3 id={`quiz-question-${index}`} tabindex="-1">
            {round.question}
          </h3>
          <p>{round.prompt}</p>

          <fieldset aria-labelledby={`quiz-question-${index}`}>
            {round.kind === "choice" && (
              <div class="quiz-choices">
                {round.options.map((option) => (
                  <label>
                    <input type="radio" name="guess" value={option} required />
                    {option}
                  </label>
                ))}
              </div>
            )}

            {round.kind === "range" && (
              <div class="quiz-range">
                <label for="quiz-pressure">Your guess</label>
                <output for="quiz-pressure">
                  <span data-pressure>{round.initial}</span> mmHg
                </output>
                <button
                  type="button"
                  data-decrease
                  aria-label="Lower guess by 1 mmHg"
                >
                  &minus;
                </button>
                <input
                  type="range"
                  id="quiz-pressure"
                  name="guess"
                  min={round.min}
                  max={round.max}
                  value={round.initial}
                />
                <button
                  type="button"
                  data-increase
                  aria-label="Raise guess by 1 mmHg"
                >
                  +
                </button>
              </div>
            )}
          </fieldset>

          <button class="button" type="submit">
            Reveal answer
          </button>
        </form>

        <div class="quiz-reveal" data-reveal hidden>
          <h3 tabindex="-1">{round.answer}</h3>
          <p data-feedback></p>
          <p>{round.explanation}</p>
          {round.sources.length > 0 && (
            <ul class="quiz-sources" role="list">
              {round.sources.map(({ label, href }) => (
                <li>
                  <a class="text-link" href={href}>
                    <span>{label}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          <button class="button" type="button" data-next>
            {index === saunaQuiz.length - 1 ? "See my score" : "Next question"}
          </button>
        </div>
      </div>
    ))}

    <div class="quiz-reveal" data-result hidden>
      <h3 tabindex="-1">
        You got <span data-score></span> out of {saunaQuiz.length}
      </h3>
      <p data-result-feedback></p>
      <div class="actions">
        <a class="text-link" href="#sauna-research" data-result-reading hidden>
          Read about the benefits
        </a>
        <button class="text-link quiz-reset" type="button" data-restart>
          Play again
        </button>
        <a class="text-link" href={sitePath("/sessions/")}>
          Explore sauna sessions
        </a>
      </div>
    </div>
  </hot-rocks-quiz>
</section>

<script>
  import "../scripts/sauna-quiz";
</script>

<style>
  .sauna-quiz {
    padding: clamp(1rem, 4vw, 2.5rem);
    border-block-start: 2px solid var(--walnut);
    background: var(--milk);
  }

  .sauna-quiz h2 {
    font-size: clamp(1.55rem, 2.7vw, 2.2rem);
  }

  .sauna-quiz h2 + p,
  form h3 + p,
  .quiz-reveal h3 + p {
    margin-block-start: 0.5rem;
  }

  hot-rocks-quiz {
    display: block;
    margin-block-start: 1.25rem;
  }

  hot-rocks-quiz:not(:defined),
  hot-rocks-quiz [hidden] {
    display: none;
  }

  .quiz-progress,
  [data-feedback] {
    margin-block-end: 0.5rem;
    font-weight: 600;
  }

  fieldset {
    min-inline-size: 0;
    margin-block: 1rem;
  }

  .quiz-choices {
    display: grid;
    gap: 0.5rem;
  }

  .quiz-choices label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-block-size: 44px;
    border-bottom: 1px solid var(--soft-rule);
    padding: 0.5rem 0.25rem;
    cursor: pointer;
  }

  .quiz-choices label:has(:checked),
  .quiz-choices label:hover {
    border-color: var(--walnut);
    background: var(--oat);
  }

  fieldset input {
    accent-color: var(--walnut);
  }

  .quiz-range {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 0.375rem 0.75rem;
  }

  .quiz-range label,
  .quiz-range output {
    grid-column: 1 / -1;
  }

  .quiz-range output {
    font-size: 1.3rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .quiz-range button {
    min-block-size: 44px;
    border: 1px solid var(--walnut);
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .quiz-range button:hover {
    background: var(--oat);
  }

  .quiz-sources {
    margin-block-start: 0.25rem;
  }

  .quiz-sources .text-link[href] {
    padding-inline: 0;
    border: 0;
    border-radius: 0;
  }

  .quiz-sources .text-link[href]:is(:hover, :focus-visible) {
    background-color: transparent;
  }

  .quiz-sources .text-link span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .quiz-reveal .button,
  .quiz-reveal .actions {
    margin-block-start: 1rem;
  }

  @media (min-width: 64rem) {
    .quiz-choices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
