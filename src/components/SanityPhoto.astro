---
import type { SitePhoto } from "../data/site-content";

interface Props {
  image: SitePhoto;
  sizes: string;
  maxWidth: number;
  quality?: number;
  class?: string;
  scrollReveal?: boolean;
  square?: boolean;
  priority?: boolean;
  transitionImage?: boolean;
}

const {
  image,
  sizes,
  maxWidth,
  quality,
  class: className,
  scrollReveal,
  square = false,
  priority = false,
  transitionImage,
} = Astro.props;
const largest = Math.min(
  maxWidth,
  image.width,
  square ? image.height : image.width,
);
const widths = [240, 360, 480, 640, 720, 800, 960, 1200, 1440].filter(
  (width) => width < largest,
);
widths.push(largest);
const urlAt = (width: number) =>
  `${image.url}?w=${width}${square ? `&h=${width}&fit=crop` : "&fit=max"}&auto=format${quality ? `&q=${quality}` : ""}`;
---

<img
  class={className}
  src={urlAt(largest)}
  srcset={widths.map((width) => `${urlAt(width)} ${width}w`).join(", ")}
  sizes={sizes}
  alt={image.alt}
  width={square ? largest : image.width}
  height={square ? largest : image.height}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  data-transition-image={transitionImage ? "" : undefined}
  data-scroll-reveal={scrollReveal ? "" : undefined}
  decoding="async"
/>
