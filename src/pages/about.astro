---
import SanityPhoto from "../components/SanityPhoto.astro";
import { getAboutContent } from "../data/site-content";
import SiteLayout from "../layouts/SiteLayout.astro";

const content = await getAboutContent();
---

<SiteLayout
  title="About Us"
  description="Meet Jacek and Andrea, the people who built The Hot Rocks Sauna by Lough Neagh."
>
  <section class="panel toast" aria-labelledby="about-title">
    <div class="wrap editorial">
      <div class="photo">
        <SanityPhoto
          image={content.photo}
          maxWidth={960}
          sizes="(max-width: 42rem) 90vw, 40vw"
          priority
          transitionImage
        />
      </div>
      <div class="editorial-copy about-copy">
        <h1 id="about-title">{content.heading}</h1>
        {content.story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <div class="actions">
          <a class="text-link" href="/sessions/#rituals">
            Explore guided rituals
          </a>
          <a class="text-link" href="/gallery/">
            View the gallery
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .about-copy h1 + p {
    margin-block-start: 1rem;
  }
</style>
