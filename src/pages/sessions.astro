---
import PageIntro from "../components/PageIntro.astro";
import SanityPhoto from "../components/SanityPhoto.astro";
import { getSessionCatalog } from "../data/sessions";
import SiteLayout from "../layouts/SiteLayout.astro";

const { all: sessions } = await getSessionCatalog();
---

<SiteLayout
  title="Sauna Sessions"
  description="Choose a communal or private wood-fired sauna session or a guided ritual at The Hot Rocks Sauna."
>
  <PageIntro
    title="Find your sauna session"
    intro="Share the heat, book the room for your group or join a guided ritual by Lough Neagh."
  >
    <div class="actions">
      <a class="button" href="/book/">
        Book a Session
      </a>
      <a class="text-link" href="/first-visit/">
        Plan Your First Visit
      </a>
    </div>
  </PageIntro>

  {sessions.map(({ id, name, summary, image }, index) => (
    <section
      id={id}
      class:list={["panel", index % 2 === 1 ? "toast" : "paper"]}
      aria-labelledby={`${id}-title`}
      tabindex="-1"
    >
      <div class="wrap editorial">
        <div class="photo" data-scroll-reveal={index > 0 ? "" : undefined}>
          <SanityPhoto
            image={image}
            maxWidth={1000}
            sizes="(max-width: 42rem) 90vw, (max-width: 80rem) 36vw, 465px"
            priority={index === 0}
          />
        </div>
        <div class="editorial-copy">
          <h2 id={`${id}-title`}>{name}</h2>
          <p>{summary}</p>
          <div class="actions">
            <a
              class="text-link"
              href={`/sessions/${id}/`}
              aria-label={`Learn more about ${name}`}
            >
              Learn more
            </a>
          </div>
        </div>
      </div>
    </section>
  ))}
</SiteLayout>
