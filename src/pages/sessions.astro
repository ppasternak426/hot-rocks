---
import PageIntro from "../components/PageIntro.astro";
import {
  onRequestSessionId,
  sessionCategories,
  sessionComparison,
} from "../data/session-comparison";
import { getSessionCatalog } from "../data/sessions";
import SiteLayout from "../layouts/SiteLayout.astro";

const { all: sessions } = await getSessionCatalog();
const groups = sessionCategories
  .map((category) => ({
    ...category,
    sessions: sessions.filter(
      ({ id }) => (sessionComparison[id]?.category ?? "other") === category.id,
    ),
  }))
  .filter((group) => group.sessions.length > 0);
---

<SiteLayout
  title="Sauna Sessions"
  description="Choose a communal or private wood-fired sauna session or a guided ritual at The Hot Rocks Sauna."
>
  <PageIntro
    title="Find your sauna session"
    intro="Share the heat, book the room for your group or join a guided ritual by Lough Neagh."
  >
    {groups.length > 1 && (
      <nav class="actions session-jumps" aria-label="Browse by session type">
        {groups.map(({ id, label }) => (
          <a class="text-link" href={`#${id}-sessions`}>
            {label}
          </a>
        ))}
      </nav>
    )}
    <div class="actions">
      <a class="button" href="/book/">
        Book a session
      </a>
    </div>
  </PageIntro>

  {groups.map(({ id: category, label, sessions }, index) => (
    <section
      id={`${category}-sessions`}
      class:list={["panel", index % 2 === 1 ? "toast" : "paper"]}
      aria-labelledby={`${category}-heading`}
      tabindex="-1"
    >
      <div class="wrap">
        <h2 id={`${category}-heading`}>{label}</h2>
        <ul class="ruled-list session-list" role="list">
          {sessions.map(({ id, name, summary }) => {
            const facts = sessionComparison[id];
            const booking =
              id === onRequestSessionId ? "By enquiry" : "Book online";
            return (
              <li id={id} tabindex="-1">
                <h3>
                  <a class="text-link" href={`/sessions/${id}/`}>
                    {facts?.displayName ?? name}
                  </a>
                </h3>
                <p class="session-facts">
                  {[facts?.duration, facts?.format, booking]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
                <p>{facts?.comparisonSummary ?? summary}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}
  <div class="wrap actions session-resources">
    <a class="text-link" href="/first-visit/">
      Plan your first visit
    </a>
    <a class="text-link" href="/events/#upcoming-events">
      See upcoming events
    </a>
  </div>
</SiteLayout>

<style>
  .page-intro .session-jumps {
    border-block-start: 1px solid var(--soft-rule);
    padding-block-start: 0.35rem;
  }

  .session-jumps a {
    min-block-size: 2.75rem;
  }

  .session-list {
    max-inline-size: 70ch;
    margin-block-start: 1.25rem;
  }

  .session-list h3 a {
    display: inline;
    font: inherit;
    min-block-size: initial;
  }

  .session-list h3 a::after {
    display: inline-block;
    margin-inline-start: 0.45em;
    vertical-align: middle;
  }

  .session-list p {
    margin-block-start: 0.4rem;
  }

  .session-list .session-facts {
    color: var(--walnut);
    font-size: 0.9375rem;
    font-weight: 400;
  }
  .session-resources {
    padding-block: 1.25rem 2rem;
  }
</style>
