---
import { sitePath } from "../data/site-path";
import PageIntro from "../components/PageIntro.astro";
import {
  sessionCategories,
  sessionComparison,
} from "../data/session-comparison";
import { getSessionCatalog, onlineBooking } from "../data/sessions";
import SiteLayout from "../layouts/SiteLayout.astro";

const { all: sessions } = await getSessionCatalog();
const groups = sessionCategories
  .map((category) => ({
    ...category,
    sessions: sessions.filter(
      ({ id, bookingDemo }) =>
        (bookingDemo?.group ?? sessionComparison[id]?.category ?? "other") ===
        category.id,
    ),
  }))
  .filter((group) => group.sessions.length > 0);
---

<SiteLayout
  title="Sauna Sessions"
  description="Choose a communal or private wood-fired sauna session or a guided ritual at The Hot Rocks Sauna."
>
  <PageIntro
    title="Find your sauna session"
    intro="Share the heat, book the room for your group or join a guided ritual by Lough Neagh."
  >
    {groups.length > 1 && (
      <nav class="actions session-jumps" aria-label="Browse by session type">
        {groups.map(({ id, label }) => (
          <a class="text-link" href={`#${id}-sessions`}>
            {label}
          </a>
        ))}
      </nav>
    )}
    <div class="actions">
      <a class="button" href={sitePath("/book/")}>
        Book a session
      </a>
    </div>
  </PageIntro>

  {groups.map(({ id: category, label, sessions }, index) => (
    <section
      id={`${category}-sessions`}
      class:list={["panel", index % 2 === 1 ? "toast" : "paper"]}
      aria-labelledby={`${category}-heading`}
      tabindex="-1"
    >
      <div class="wrap">
        <h2 id={`${category}-heading`}>{label}</h2>
        <ul class="ruled-list session-list" role="list">
          {sessions.map((session) => {
            const { id, name, summary } = session;
            const facts = sessionComparison[id];
            const booking = onlineBooking(session)
              ? "Book online"
              : "By enquiry";
            return (
              <li id={id} tabindex="-1">
                <a
                  class="session-entry"
                  href={sitePath(`/sessions/${id}/`)}
                  aria-labelledby={`session-title-${id}`}
                >
                  <h3 id={`session-title-${id}`}>
                    <span>{facts?.displayName ?? name}</span>
                    <span class="feature-card-arrow" aria-hidden="true" />
                  </h3>
                  <p class="session-facts">
                    {[facts?.duration, facts?.format, booking]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                  <p>{facts?.comparisonSummary ?? summary}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}
  <div class="wrap actions session-resources">
    <a class="text-link" href={sitePath("/first-visit/")}>
      Plan your first visit
    </a>
    <a class="text-link" href={sitePath("/events/#upcoming-events")}>
      See upcoming events
    </a>
  </div>
</SiteLayout>

<style>
  .page-intro .session-jumps {
    border-block-start: 1px solid var(--soft-rule);
    padding-block-start: 0.35rem;
  }

  .session-jumps a {
    min-block-size: 2.75rem;
  }

  .session-list {
    max-inline-size: 70ch;
    margin-block-start: 1.25rem;
  }

  .session-list > li {
    padding-block: 0;
  }

  .session-entry {
    position: relative;
    isolation: isolate;
    display: block;
    padding: 0.85rem 0.75rem;
    text-decoration: none;
  }

  .session-entry h3 {
    display: flex;
    align-items: center;
    gap: 0.45em;
  }

  .session-entry::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--walnut) 9%, transparent),
      transparent
    );
    opacity: 0;
    content: "";
  }

  .session-entry:is(:hover, :focus-visible)::before {
    opacity: 1;
  }

  .session-entry:focus-visible {
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .session-entry::before {
      transition: opacity 200ms ease-out;
    }

    .session-entry .feature-card-arrow {
      transition: translate 160ms ease-out;
    }

    .session-entry:is(:hover, :focus-visible) .feature-card-arrow {
      translate: 3px 0;
    }
  }

  .session-list p {
    margin-block-start: 0.4rem;
  }

  .session-list .session-facts {
    color: var(--walnut);
    font-size: 0.9375rem;
    font-weight: 400;
  }
  .session-resources {
    padding-block: 1.25rem 2rem;
  }
</style>
