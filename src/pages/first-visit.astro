---
import { sitePath } from "../data/site-path";
import PageIntro from "../components/PageIntro.astro";
import { getFirstVisitContent } from "../data/site-content";
import SiteLayout from "../layouts/SiteLayout.astro";

const { heading, intro, questions } = await getFirstVisitContent();
---

<SiteLayout
  title="First Visit & FAQ"
  description="Prepare for your first visit to The Hot Rocks Sauna, from what to bring to finding Gawley’s Gate."
>
  <PageIntro title={heading} intro={intro}>
    <div class="actions">
      <a class="button" href={sitePath("/sessions/")}>
        Explore sessions
      </a>
      <a class="text-link" href={sitePath("/visit/#directions")}>
        Find us
      </a>
    </div>
  </PageIntro>

  <section id="faq" class="panel paper" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title">Frequently asked questions</h2>
      <div class="ruled-list faq-list">
        {questions.map(({ question, answer }) => (
          <details>
            <summary>
              {question}
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M4.5 10h11" />
                <path class="faq-plus-vertical" d="M10 4.5v11" />
              </svg>
            </summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
      <a class="text-link mt-3" href={sitePath("/visit/#contact")}>
        Ask us a question
      </a>
    </div>
  </section>
  <section id="safety" class="panel toast" aria-labelledby="safety-title">
    <div class="wrap block-copy">
      <h2 id="safety-title">Before you visit</h2>
      <p>
        Check the sauna rules and booking terms before you reserve a session.
      </p>
      <div class="actions">
        <a class="text-link" href={sitePath("/terms/")}>
          Read the sauna rules
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
