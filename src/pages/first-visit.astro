---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="First Visit & FAQ">
  <h1 class="text-3xl font-semibold">First Visit &amp; FAQ</h1>
  <p class="mt-4">
    This page will help guests prepare for their visit and answer common
    questions.
  </p>
  <section id="safety" class="mt-8">
    <h2 class="text-xl font-semibold">Preparing for your visit</h2>
    <p>Practical and safety information will appear here.</p>
  </section>
  <section id="faq" class="mt-8">
    <h2 class="text-xl font-semibold">Frequently asked questions</h2>
    <p>Answers to common questions will appear here.</p>
  </section>
</SiteLayout>
