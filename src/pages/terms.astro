---
import PageIntro from "../components/PageIntro.astro";
import { termsUrl } from "../data/sauna";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Terms & Conditions"
  description="Find the current sauna rules, booking terms and gift voucher conditions for The Hot Rocks Sauna."
>
  <PageIntro
    title="Terms & Conditions"
    intro="Read the current sauna rules, booking terms and gift voucher conditions on the Hot Rocks booking site."
  >
    <div class="actions">
      <a class="button" href={termsUrl}>
        Read the published terms
      </a>
      <a class="text-link" href="/first-visit/">
        Plan your first visit
      </a>
    </div>
  </PageIntro>
</SiteLayout>
