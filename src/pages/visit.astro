---
import { sitePath } from "../data/site-path";
import LocationMap from "../components/LocationMap.astro";
import PageIntro from "../components/PageIntro.astro";
import { getVisitSettings } from "../data/site-content";
import SiteLayout from "../layouts/SiteLayout.astro";

const {
  intro,
  address,
  directionsUrl,
  contactNote,
  contactEmail,
  phoneDisplay,
  contactPhoneUrl,
  contactUrl,
} = await getVisitSettings();
---

<SiteLayout
  title="Visit & Contact"
  description="Get directions to The Hot Rocks Sauna at Gawley’s Gate, or call or email the hosts with questions about your visit."
>
  <PageIntro title="Visit & Contact" intro={intro}>
    <address id="directions" class="visit-address" tabindex="-1">
      {address}
    </address>
    <div class="actions">
      <a class="button" href={directionsUrl}>
        Get directions
      </a>
      <a class="text-link" href="#contact">
        Contact us
      </a>
    </div>
  </PageIntro>

  <div class="paper">
    <LocationMap />
  </div>

  <section id="contact" class="panel toast" aria-labelledby="contact-title">
    <div class="wrap editorial">
      <div class="editorial-copy">
        <h2 id="contact-title">Get in touch</h2>
        <p>{contactNote}</p>
        <div class="actions">
          <a class="text-link" href={sitePath("/gift-vouchers/")}>
            Gift vouchers
          </a>
        </div>
      </div>
      <ul class="ruled-list visit-contact-methods" role="list">
        <li>
          <a href={contactPhoneUrl}>
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M7 3H4.5A1.5 1.5 0 0 0 3 4.6 18 18 0 0 0 19.4 21 1.5 1.5 0 0 0 21 19.5V17l-5-2-1.5 2.5a14 14 0 0 1-8-8L9 8 7 3Z" />
            </svg>
            <span>
              <span class="visit-contact-label">Call us</span>
              <span class="visit-contact-value link-label">{phoneDisplay}</span>
            </span>
          </a>
        </li>
        <li>
          <a href={contactUrl}>
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m4 6 8 7 8-7" />
            </svg>
            <span>
              <span class="visit-contact-label">Email us</span>
              <span class="visit-contact-value link-label">{contactEmail}</span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .visit-address {
    margin-block-start: 0.75rem;
    font-style: normal;
    font-weight: 600;
  }

  .visit-contact-methods li {
    padding-block: 0;
  }

  .visit-contact-methods a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-block-size: 44px;
    padding-block: 0.8rem;
    color: var(--espresso);
    text-decoration-line: none;
  }

  .visit-contact-methods svg {
    color: var(--walnut);
  }

  .visit-contact-label {
    display: block;
    color: var(--walnut);
    font-size: 0.9375rem;
  }

  .visit-contact-value {
    font-size: clamp(1.06rem, 2vw, 1.2rem);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration-line: underline;
  }
</style>
