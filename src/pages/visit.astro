---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Visit & Contact">
  <h1 class="text-3xl font-semibold">Visit &amp; Contact</h1>
  <p class="mt-4">
    This page will contain the location, directions and contact information.
  </p>
  <section id="directions" class="mt-8">
    <h2 class="text-xl font-semibold">Find us</h2>
    <p>A map and directions will appear here.</p>
  </section>
  <section id="contact" class="mt-8">
    <h2 class="text-xl font-semibold">Contact</h2>
    <p>Contact details and a way to send an enquiry will appear here.</p>
  </section>
</SiteLayout>
