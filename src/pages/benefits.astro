---
import SaunaQuiz from "../components/SaunaQuiz.astro";
import { getSaunaBenefitsContent } from "../data/site-content";
import SiteLayout from "../layouts/SiteLayout.astro";

const { intro, heading, topics } = await getSaunaBenefitsContent();
---

<SiteLayout
  title="Sauna Benefits & Quiz"
  description="Explore the warmth, quiet and everyday comforts of a sauna by Lough Neagh, then try the Hot Rocks Sauna Quiz."
>
  <header class="wrap benefits-intro">
    <h1>Sauna benefits</h1>
    <p>{intro}</p>
  </header>
  <div class="paper research-band">
    <section
      id="sauna-research"
      class="wrap research"
      aria-labelledby="sauna-research-title"
      tabindex="-1"
    >
      <h2 id="sauna-research-title">{heading}</h2>
      {topics.map(({ title, body, sources }) => (
        <article>
          <h3>{title}</h3>
          <p>{body}</p>
          <details>
            <summary>Study links</summary>
            <ul>
              {sources.map(({ href, label }) => (
                <li>
                  <a class="text-link text-link-plain" href={href}>
                    <span>{label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </article>
      ))}
    </section>
  </div>
  <div class="wrap benefits-quiz">
    <SaunaQuiz />
  </div>
</SiteLayout>

<style>
  .benefits-intro,
  .benefits-quiz {
    max-inline-size: 64rem;
    padding-block: clamp(1.75rem, 5vw, 4.5rem);
  }

  .benefits-intro p {
    margin-block-start: 0.75rem;
    font-size: 1.125rem;
  }

  .research-band {
    padding-block: var(--panel-space);
  }

  .research {
    max-inline-size: 64rem;
  }

  .research h2 {
    margin-block-end: 1.5rem;
  }

  .research article {
    border-block-start: 1px solid var(--soft-rule);
    padding-block: clamp(1.4rem, 3vw, 2.5rem);
  }

  .research h3 {
    margin-block-end: 0.65rem;
  }

  .research p {
    line-height: 1.65;
  }

  @media (min-width: 48rem) {
    .research article {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: clamp(2rem, 5vw, 4rem);
    }

    .research article > :not(h3) {
      grid-column: 2;
    }
  }

  .research summary {
    align-content: center;
    min-block-size: 44px;
    cursor: pointer;
    font-weight: 600;
  }

  .research details {
    margin-block-start: 0.25rem;
  }
</style>
