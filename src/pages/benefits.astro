---
import SaunaQuiz from "../components/SaunaQuiz.astro";
import { benefitTopics, saunaQuiz } from "../data/sauna-benefits";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Sauna Benefits & Quiz"
  description={`How well do you know sauna research? Answer ${saunaQuiz.length} questions about sleep, blood pressure and long-term studies in The Hot Rocks Sauna Quiz.`}
>
  <div class="wrap benefits">
    <div class="quiz-intro-layout">
      <header class="benefits-intro">
        <h1>Sauna benefits</h1>
        <p>
          Explore what sauna studies tell us about sleep, blood pressure and
          long-term health.
        </p>
        <a class="text-link" href="#sauna-research">
          Skip to the research
        </a>
      </header>

      <SaunaQuiz />
    </div>
  </div>
  <div class="paper research-band">
    <section
      id="sauna-research"
      class="wrap research"
      aria-labelledby="sauna-research-title"
    >
      <h2 id="sauna-research-title">What researchers have studied</h2>
      {benefitTopics.map(({ title, paragraphs, sources }) => (
        <article>
          <h3>{title}</h3>
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <details>
            <summary>Study sources</summary>
            <ul>
              {sources.map(({ href, label }) => (
                <li>
                  <a class="text-link" href={href}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </article>
      ))}
    </section>
  </div>
</SiteLayout>

<style>
  .benefits {
    max-inline-size: 64rem;
    padding-block: clamp(1.75rem, 5vw, 4.5rem) var(--panel-space);
  }

  .quiz-intro-layout {
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }

  @media (min-width: 58rem) {
    .quiz-intro-layout {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
  }

  .benefits-intro p {
    margin-block-start: 0.75rem;
    font-size: 1.125rem;
  }

  .research-band {
    padding-block: var(--panel-space);
  }

  .research {
    max-inline-size: 64rem;
  }

  .research h2 {
    margin-block-end: 1.5rem;
  }

  .research article {
    border-block-start: 1px solid var(--soft-rule);
    padding-block: clamp(1.4rem, 3vw, 2.5rem);
  }

  .research h3 {
    margin-block-end: 0.65rem;
  }

  .research p {
    line-height: 1.65;
  }

  @media (min-width: 48rem) {
    .research article {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: clamp(2rem, 5vw, 4rem);
    }

    .research article > :not(h3) {
      grid-column: 2;
    }
  }

  .research summary {
    align-content: center;
    min-block-size: 44px;
    cursor: pointer;
    font-weight: 600;
  }

  .research details {
    margin-block-start: 0.25rem;
  }
</style>
