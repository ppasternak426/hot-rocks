---
import PageIntro from "../components/PageIntro.astro";
import SanityPhoto from "../components/SanityPhoto.astro";
import { getGalleryContent } from "../data/site-content";
import SiteLayout from "../layouts/SiteLayout.astro";

const { heading, intro, photos } = await getGalleryContent();
---

<SiteLayout
  title="Gallery"
  description="See the wood-fired sauna, its hosts and the view over Lough Neagh."
>
  <PageIntro title={heading} intro={intro} />

  <div class="wrap gallery">
    {photos.map((image, index) => (
      <div
        class:list={["photo", index === 0 && "gallery-wide"]}
        data-scroll-reveal={index > 0 ? "" : undefined}
      >
        <SanityPhoto
          image={image}
          maxWidth={index === 0 ? 1600 : 960}
          priority={index === 0}
          sizes={
            index === 0
              ? "(max-width: 83rem) 90vw, 1200px"
              : "(max-width: 42rem) 90vw, 30vw"
          }
        />
      </div>
    ))}
    <div class="actions gallery-wide">
      <a class="text-link" href="/about/">
        Meet the Hosts
      </a>
      <a class="text-link" href="/visit/">
        Find the Sauna
      </a>
    </div>
  </div>
</SiteLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.125rem, 2.4vw, 2rem);
    padding-block-end: var(--panel-space);
  }

  .gallery-wide {
    grid-column: 1 / -1;
  }

  .gallery .photo {
    aspect-ratio: 4 / 5;
  }

  .gallery .photo.gallery-wide {
    aspect-ratio: 2.25;
  }

  @media (max-width: 42rem) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .gallery .photo,
    .gallery .photo.gallery-wide {
      aspect-ratio: 1.5;
    }
  }
</style>
