---
import { sitePath } from "../data/site-path";
import { Image } from "astro:assets";
import view from "../assets/home/lough-neagh-sauna.jpg";
import {
  bookingSteps,
  formatSampleDuration,
  formatSamplePrice,
  sessionGroups,
} from "../data/booking-demo";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSessionCatalog, onlineBooking } from "../data/sessions";
import "../styles/booking.css";

const { all: sessions } = await getSessionCatalog();
const services = sessions
  .map(onlineBooking)
  .filter((service) => service !== undefined);
const groups = sessionGroups
  .map((group) => ({
    ...group,
    services: services.filter((service) => service.group === group.id),
  }))
  .filter((group) => group.services.length > 0);
const unconfiguredSessions = sessions.filter(
  (session) => !onlineBooking(session),
);
const bookingApi = import.meta.env.PUBLIC_BOOKING_API_URL;
---

<SiteLayout
  title="Book a Session"
  description="Choose your sauna session, group size and a time from the booking calendar."
>
  <div class="wrap booking-page">
    <header class="booking-intro">
      <h1>Book a sauna session</h1>
    </header>

    <noscript>
      <p>Enable JavaScript to choose a booking time.</p>
    </noscript>

    <form
      id="booking-demo"
      data-services={JSON.stringify(services)}
      data-api={bookingApi}
      inert
    >
      <ol class="booking-progress" aria-label="Booking progress">
        {bookingSteps.map(({ id, label }, index) => (
          <li
            data-booking-progress={id}
            aria-current={index === 0 ? "step" : undefined}
          >
            <span class="booking-progress-entry" data-progress-label>
              <span class="booking-progress-number" aria-hidden="true">
                {index + 1}
              </span>
              <span>{label}</span>
            </span>
            <button
              class="booking-progress-entry"
              type="button"
              aria-label={`Edit ${label.toLowerCase()}`}
              aria-controls={`booking-step-${id}`}
              data-progress-edit
              hidden
            >
              <span class="booking-progress-number" aria-hidden="true">
                {index + 1}
              </span>
              <span>{label}</span>
            </button>
          </li>
        ))}
      </ol>

      <div class="booking-layout">
        <div class="booking-workspace">
          <fieldset
            id="booking-step-session"
            data-booking-step="session"
            class="booking-step"
          >
            <legend class="sr-only">Choose a session</legend>
            <h2 tabindex="-1">Choose a session</h2>
            <p class="booking-lede">
              Choose the sauna session you’d like to book.
            </p>
            {groups.map(({ label, services }) => (
              <fieldset class="booking-service-group">
                <legend>{label}</legend>
                {services.map((service) => (
                  <label class="booking-service">
                    <input
                      type="radio"
                      name="service"
                      value={service.id}
                      required
                    />
                    <span class="booking-service-name">
                      <strong>{service.name}</strong>
                      <span>
                        {formatSampleDuration(service.minutes)}
                        {service.note && <> · {service.note}</>}
                      </span>
                    </span>
                    {!service.linked && (
                      <span class="booking-price">
                        <strong>
                          {formatSamplePrice(service.samplePrice)}
                        </strong>
                        <span>per {service.billing}</span>
                      </span>
                    )}
                  </label>
                ))}
              </fieldset>
            ))}
            {!sessions.length && <p>No sessions are currently available.</p>}
            {unconfiguredSessions.length > 0 && (
              <div class="booking-service-group">
                <h3>More sessions</h3>
                <p>Available by request.</p>
                <ul>
                  {unconfiguredSessions.map((session) => (
                    <li>
                      <a href={sitePath(`/sessions/${session.id}/`)}>
                        {session.name}
                      </a>
                    </li>
                  ))}
                </ul>
                <a
                  class="text-link booking-contact-link"
                  href={sitePath("/visit/#contact")}
                >
                  <span>Contact us</span>
                </a>
              </div>
            )}
          </fieldset>

          <fieldset
            id="booking-step-time"
            data-booking-step="time"
            class="booking-step"
            hidden
            disabled
          >
            <legend class="sr-only">Choose a date and time</legend>
            <h2 tabindex="-1">Choose a date and time</h2>
            <p class="booking-lede">Times are shown in UK time.</p>
            <p class="booking-picked-service" data-booking-picked-service></p>
            <div class="booking-field booking-field-short">
              <label id="booking-guests-label" for="booking-guests">
                Guests
              </label>
              <select name="guests" id="booking-guests" required></select>
              <button
                type="button"
                class="booking-guests-trigger"
                aria-labelledby="booking-guests-label booking-guests-value"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="booking-guests-options"
                popovertarget="booking-guests-options"
                hidden
              >
                <span id="booking-guests-value"></span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="m4 6 4 4 4-4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </button>
              <div
                id="booking-guests-options"
                class="booking-guests-options"
                role="listbox"
                aria-labelledby="booking-guests-label"
                popover="manual"
                hidden
              ></div>
            </div>
            <fieldset class="booking-picker">
              <legend>Available dates</legend>
              <div class="booking-calendar-header">
                <button
                  type="button"
                  class="booking-text-button"
                  data-booking-action="previous-month"
                  aria-label="Previous month"
                >
                  ‹
                </button>
                <p data-booking-month aria-live="polite"></p>
                <button
                  type="button"
                  class="booking-text-button"
                  data-booking-action="next-month"
                  aria-label="Next month"
                >
                  ›
                </button>
              </div>
              <div class="booking-calendar" data-booking-dates></div>
              <p role="status" data-booking-date-status></p>
              <a
                class="text-link booking-contact-link"
                href={sitePath("/visit/#contact")}
                data-booking-availability-contact
                hidden
              >
                <span>Contact us about this session</span>
              </a>
            </fieldset>
            <fieldset
              class="booking-picker"
              aria-describedby="booking-times-caption"
            >
              <legend>Available times</legend>
              <p
                id="booking-times-caption"
                class="booking-times-caption"
                data-booking-times-caption
              >
                Choose a date to see its times.
              </p>
              <div class="booking-time-panel">
                <div
                  id="booking-time-options"
                  class="booking-choices booking-time-options"
                  data-booking-times
                ></div>
                <div class="booking-time-loading" aria-hidden="true">
                  <span class="booking-time-loading-track"></span>
                </div>
              </div>
              <p class="sr-only" role="status" data-booking-times-status></p>
            </fieldset>
            <p
              class="booking-error"
              role="alert"
              data-booking-slot-error
              hidden
            ></p>
          </fieldset>

          <fieldset
            id="booking-step-details"
            data-booking-step="details"
            class="booking-step"
            hidden
            disabled
          >
            <legend class="sr-only">Guest details</legend>
            <h2 tabindex="-1">Guest details</h2>
            <div class="booking-fields">
              <div class="booking-field">
                <label for="booking-name">Full name</label>
                <input
                  id="booking-name"
                  name="full-name"
                  type="text"
                  autocomplete="name"
                  aria-describedby="booking-name-error"
                  required
                  maxlength="100"
                />
                <p
                  class="booking-field-error"
                  id="booking-name-error"
                  hidden
                ></p>
              </div>
              <div class="booking-field">
                <label for="booking-email">Email address</label>
                <input
                  id="booking-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  autocapitalize="none"
                  spellcheck="false"
                  aria-describedby="booking-email-error"
                  required
                  pattern=".+@.+\..+"
                  maxlength="254"
                />
                <p
                  class="booking-field-error"
                  id="booking-email-error"
                  hidden
                ></p>
              </div>
            </div>
            <p class="sr-only" role="status" data-booking-field-status></p>
          </fieldset>

          <fieldset
            id="booking-step-review"
            data-booking-step="review"
            class="booking-step"
            hidden
            disabled
          >
            <legend class="sr-only">Review your booking</legend>
            <h2 tabindex="-1">Review your booking</h2>
            <p class="booking-lede">
              You’ll enter your payment details on Stripe.
            </p>
            <section
              class="booking-review-block"
              aria-labelledby="review-details"
            >
              <h3 id="review-details">Guest details</h3>
              <p data-booking-guest-summary></p>
              <button
                type="button"
                class="booking-text-button"
                data-booking-action="details"
              >
                Edit guest details
              </button>
            </section>
            <p
              class="booking-error"
              role="alert"
              data-booking-submit-error
              hidden
            ></p>
            <p class="sr-only" role="status" data-booking-submit-status></p>
          </fieldset>

          <fieldset
            data-booking-step="payment"
            class="booking-step"
            hidden
            disabled
          >
            <legend class="sr-only">Payment status</legend>
            <h2 tabindex="-1" data-booking-payment-heading>
              Checking payment
            </h2>
            <div role="status" aria-atomic="true">
              <p class="booking-lede" data-booking-payment-note>
                We’re checking the payment status for your booking.
              </p>
              <p class="booking-lede" data-booking-payment-reference hidden></p>
            </div>
            <div class="booking-complete-actions">
              <button
                type="button"
                class="button"
                data-booking-action="check-payment"
                hidden
              >
                Check payment status
              </button>
              <button
                type="button"
                class="button"
                data-booking-action="new-payment-booking"
                hidden
              >
                Choose another time
              </button>
            </div>
          </fieldset>
        </div>

        <aside class="booking-summary" aria-labelledby="booking-summary-title">
          <div class="booking-summary-photo photo">
            <Image
              src={view}
              alt=""
              widths={[400, 640, 960]}
              sizes="(min-width: 54rem) 22rem, 90vw"
              format="webp"
              class="booking-summary-image"
            />
          </div>
          <div class="booking-summary-body">
            <h2 id="booking-summary-title" tabindex="-1">
              Your visit
            </h2>
            <p>Gawley’s Gate, Lough Neagh</p>
            <p class="booking-empty" data-booking-empty>
              Choose a session to start your booking.
            </p>
            <div class="booking-summary-selection" role="status">
              <strong data-booking-summary-session hidden></strong>
              <p data-booking-summary-date hidden></p>
            </div>
            <dl class="booking-totals" data-booking-totals hidden>
              <div class="booking-total">
                <dt>Total</dt>
                <dd data-booking-total></dd>
              </div>
            </dl>
          </div>
        </aside>
        <div class="booking-actions" data-booking-actions>
          <button
            type="button"
            class="booking-text-button"
            data-booking-action="back"
            hidden
          >
            Back
          </button>
          <button type="submit" class="button" data-booking-next>
            Choose date and time
          </button>
        </div>
      </div>
    </form>

    <nav class="booking-help" aria-label="Booking help">
      <a href={sitePath("/sessions/")} class="text-link">
        Compare sessions
      </a>
      <a href={sitePath("/first-visit/")} class="text-link">
        Plan your first visit
      </a>
    </nav>
  </div>
</SiteLayout>

<script>
  import "../scripts/booking";
</script>
