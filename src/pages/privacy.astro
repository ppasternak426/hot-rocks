---
import PageIntro from "../components/PageIntro.astro";
import { getVisitSettings } from "../data/site-content";
import SiteLayout from "../layouts/SiteLayout.astro";

const { contactUrl } = await getVisitSettings();
---

<SiteLayout
  title="Privacy Policy"
  description="Contact The Hot Rocks Sauna with questions about your personal information."
>
  <PageIntro
    title="Privacy Policy"
    intro="The privacy policy is being prepared. If you have a question about your personal information, contact The Hot Rocks Sauna."
  >
    <div class="actions">
      <a class="button" href={contactUrl}>
        Email The Hot Rocks Sauna
      </a>
    </div>
  </PageIntro>
</SiteLayout>
