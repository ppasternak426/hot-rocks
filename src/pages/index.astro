---
import { Image } from "astro:assets";
import saunaBenefitsPhoto from "../assets/home/sauna-benefits-ritual.jpeg";
import saunaInterior from "../assets/home/sauna-interior.jpg";
import FeatureCard from "../components/FeatureCard.astro";
import HomeEvents from "../components/HomeEvents.astro";
import LocationMap from "../components/LocationMap.astro";
import SanityPhoto from "../components/SanityPhoto.astro";
import { benefitHighlights } from "../data/sauna-benefits";
import { getHomeContent } from "../data/site-content";
import { getSessionCatalog } from "../data/sessions";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";
import "../styles/photo-overlay-card.css";

const [content, { featured }] = await Promise.all([
  getHomeContent(),
  getSessionCatalog(),
]);
const benefitIcons = {
  moon: "M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z",
  pulse: "M3 12h4l2.5-5 4 10L16 12h5",
  movement:
    "M13 5a1.5 1.5 0 1 0 0 .01M5 10l4-2 4 3 5-.5M10 9l-2 5 4 2 1 4M8 14l-3 4H3",
};
---

<SiteLayout
  title={content.heading}
  description="Visit The Hot Rocks Sauna at Gawley’s Gate. Explore communal and private wood-fired sauna sessions and guided rituals by Lough Neagh."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-photo">
      <Image
        src={saunaInterior}
        alt="Wooden benches inside The Hot Rocks Sauna"
        widths={[480, 720, 960, 1201]}
        sizes="max(100vw, 75svh)"
        format="webp"
        quality={78}
        priority
        data-transition-image=""
      />
    </div>
    <div class="wrap home-hero-copy">
      <h1 id="home-title">{content.heading}</h1>
      <p>{content.intro}</p>
      <div class="actions">
        <a class="button button-light" href="/book/">
          Book a Session
        </a>
        <a
          class="text-link"
          href={featured.length ? "#sessions" : "/sessions/"}
        >
          Explore Sessions
        </a>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section
      id="sessions"
      class="panel paper"
      aria-labelledby="sessions-title"
      tabindex="-1"
    >
      <div class="wrap">
        <div class="section-heading">
          <div>
            <h2 id="sessions-title">{content.sessionsHeading}</h2>
            <p>{content.sessionsIntro}</p>
          </div>
          <a class="text-link" href="/sessions/">
            See All Session Details
          </a>
        </div>
        <ul class="feature-grid" role="list">
          {featured.map(({ id, name, summary, image }) => (
            <FeatureCard
              href={`/sessions/${id}/`}
              headingId={
                id === featured[0]?.id
                  ? "featured-session-title"
                  : `choice-${id}`
              }
              title={name}
              description={summary}
              image={image}
            />
          ))}
        </ul>
      </div>
    </section>
  )}

  <LocationMap variant="home-intro" />

  <HomeEvents />

  <section
    id="benefits"
    class="panel benefits-preview"
    aria-labelledby="benefits-title"
  >
    <Image
      class="benefits-backdrop"
      src={saunaBenefitsPhoto}
      alt=""
      widths={[800, 1120, 1440, 1600]}
      sizes="max(100vw, 68rem)"
      format="webp"
      quality={80}
      data-scroll-reveal
    />
    <div class="wrap">
      <div class="editorial-copy benefits-panel photo-overlay-card">
        <h2 id="benefits-title">Sauna benefits</h2>
        <ul class="benefit-highlights" role="list">
          {benefitHighlights.map(({ icon, title, summary }) => (
            <li>
              <span class="benefit-highlight-icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d={benefitIcons[icon]} />
                </svg>
              </span>
              <div>
                <h3>{title}</h3>
                <p>{summary}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="actions">
          <a class="text-link" href="/benefits/">
            Explore benefits and take the quiz
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="panel" aria-labelledby="hosts-title" tabindex="-1">
    <div class="wrap editorial">
      <div class="photo hosts-photo" data-scroll-reveal>
        <SanityPhoto
          image={content.hostsPhoto}
          maxWidth={960}
          sizes="(max-width: 42rem) 90vw, 40vw"
        />
      </div>
      <div class="editorial-copy">
        <h2 id="hosts-title">{content.hostsHeading}</h2>
        <p>{content.hostsIntro}</p>
        <div class="actions">
          <a class="text-link" href="/about/">
            Read Their Story
          </a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
