---
import HomeEvents from "../components/HomeEvents.astro";
import LocationMap from "../components/LocationMap.astro";
import SanityPhoto from "../components/SanityPhoto.astro";
import { getHomeContent } from "../data/site-content";
import { getSessionCatalog } from "../data/sessions";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";

const [content, catalog] = await Promise.all([
  getHomeContent(),
  getSessionCatalog(),
]);
const [featured, ...otherSessions] = catalog.featured;
---

<SiteLayout
  title={content.heading}
  description="Visit The Hot Rocks Sauna at Gawley’s Gate. Explore communal and private wood-fired sauna sessions and guided rituals by Lough Neagh."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-window photo-corners">
      <SanityPhoto
        image={content.photo}
        maxWidth={1600}
        quality={72}
        sizes="100vw"
        priority
        transitionImage
      />
    </div>
    <div class="wrap home-hero-copy">
      <h1 id="home-title">{content.heading}</h1>
      <p>{content.intro}</p>
      <div class="actions">
        <a class="button" href="/book/">
          Book a Session
        </a>
        <a class="text-link" href={featured ? "#sessions" : "/sessions/"}>
          Explore Sessions
        </a>
      </div>
    </div>
  </section>

  {featured && (
    <section
      id="sessions"
      class="home-sessions home-panel panel paper"
      aria-labelledby="sessions-title"
      tabindex="-1"
    >
      <div class="wrap">
        <h2 id="sessions-title">{content.sessionsHeading}</h2>
        <p class="intro">{content.sessionsIntro}</p>
        <div class="session-menu">
          <article class="session-feature">
            <a
              class="session-link session-feature-link"
              href={`/sessions/#${featured.id}`}
              aria-labelledby="featured-session-title"
            >
              <div class="photo photo-corners">
                <SanityPhoto
                  image={featured.image}
                  maxWidth={1200}
                  sizes="(max-width: 42rem) 90vw, (max-width: 80rem) 48vw, 610px"
                />
              </div>
              <h3 id="featured-session-title" class="link-label">
                {featured.name}
              </h3>
              <p>{featured.summary}</p>
            </a>
          </article>
          <div>
            <div class="ruled-list">
              {otherSessions.map((session) => (
                <article>
                  <a
                    class="session-link session-row"
                    href={`/sessions/#${session.id}`}
                    aria-labelledby={`choice-${session.id}`}
                  >
                    <div>
                      <h3 id={`choice-${session.id}`} class="link-label">
                        {session.name}
                      </h3>
                      <p>{session.summary}</p>
                    </div>
                    <div class="photo photo-corners">
                      <SanityPhoto
                        image={session.image}
                        maxWidth={400}
                        sizes="(max-width: 42rem) 25vw, 160px"
                      />
                    </div>
                  </a>
                </article>
              ))}
            </div>
            <a class="text-link" href="/sessions/">
              See All Session Details
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <HomeEvents />

  <section
    id="about"
    class="panel toast"
    aria-labelledby="hosts-title"
    tabindex="-1"
  >
    <div class="wrap editorial">
      <div class="photo photo-corners hosts-photo">
        <SanityPhoto
          image={content.hostsPhoto}
          maxWidth={960}
          sizes="(max-width: 42rem) 90vw, 40vw"
        />
      </div>
      <div class="editorial-copy">
        <h2 id="hosts-title">{content.hostsHeading}</h2>
        <p>{content.hostsIntro}</p>
        <div class="actions">
          <a class="text-link" href="/about/">
            Read Their Story
          </a>
          <a class="text-link" href="/first-visit/">
            Plan Your First Visit
          </a>
        </div>
      </div>
    </div>
  </section>

  <LocationMap home />
</SiteLayout>
