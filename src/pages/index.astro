---
import { sitePath } from "../data/site-path";
import { createImageUrlBuilder } from "@sanity/image-url";
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";
import saunaBenefitsPhoto from "../assets/home/sauna-benefits-ritual.jpeg";
import FeatureCard from "../components/FeatureCard.astro";
import HomeEvents from "../components/HomeEvents.astro";
import HomeOpinions from "../components/HomeOpinions.astro";
import LocationMap from "../components/LocationMap.astro";
import SanityPhoto from "../components/SanityPhoto.astro";
import { getFeaturedEvents } from "../data/events";
import { benefitHighlights } from "../data/sauna-benefits";
import { sessionComparison } from "../data/session-comparison";
import { getHomeContent } from "../data/site-content";
import { getSessionCatalog } from "../data/sessions";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home.css";

const [content, { featured, all: sessions }, featuredEvents] =
  await Promise.all([
    getHomeContent(),
    getSessionCatalog(),
    getFeaturedEvents(),
  ]);
const communalSession = sessions.find(({ id }) => id === "communal");
const { photo } = content;
const mobileHeroRatio = 4 / 7;
const mobileHeroMaxWidth = Math.max(
  1,
  Math.floor(
    Math.min(
      800,
      photo.width * (1 - (photo.crop?.left ?? 0) - (photo.crop?.right ?? 0)),
      photo.height *
        (1 - (photo.crop?.top ?? 0) - (photo.crop?.bottom ?? 0)) *
        mobileHeroRatio,
    ),
  ),
);
const mobileHero = createImageUrlBuilder(sanityClient)
  .image({
    asset: { url: photo.url },
    crop: photo.crop ?? undefined,
    hotspot: photo.hotspot ?? { x: 0.54, y: 0.5, width: 0, height: 0 },
  })
  .fit("crop")
  .auto("format")
  .quality(72);
const mobileHeroSrcset = [
  ...[320, 400, 480, 560, 640, 720].filter(
    (width) => width < mobileHeroMaxWidth,
  ),
  mobileHeroMaxWidth,
]
  .map((width) => {
    const height = Math.round(width / mobileHeroRatio);
    return `${mobileHero.size(width, height).url()} ${width}w`;
  })
  .join(", ");
const benefitsImageSizes =
  "(max-width: 47.99rem) clamp(46rem, 205vw, 57.5rem), max(100vw, 53rem)";
const [sessionsIntroStart, recommendation, sessionsIntroEnd] =
  content.sessionsIntro.split(/(start with a shared session)/i);

const benefitIcons = {
  moon: "M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z",
  pulse: "M3 12h4l2.5-5 4 10L16 12h5",
  movement:
    "M13 5a1.5 1.5 0 1 0 0 .01M5 10l4-2 4 3 5-.5M10 9l-2 5 4 2 1 4M8 14l-3 4H3",
};
---

<SiteLayout
  title={content.heading}
  description="Visit The Hot Rocks Sauna at Gawley’s Gate. Explore communal and private wood-fired sauna sessions and guided rituals by Lough Neagh."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-photo">
      <picture>
        <source
          media="(width < 48rem) and (orientation: portrait)"
          sizes="max(100vw, 57svh)"
          srcset={mobileHeroSrcset}
        />
        <SanityPhoto
          image={photo}
          maxWidth={1600}
          sizes="max(100vw, 75svh)"
          quality={78}
          priority
          transitionImage
        />
      </picture>
    </div>
    <div class="wrap home-hero-copy">
      <h1 id="home-title">{content.heading}</h1>
      <p>{content.intro}</p>
      <div id="book" class="actions" tabindex="-1">
        <a class="button button-light" href={sitePath("/book/")}>
          Book a session
        </a>
        <a
          class="text-link"
          href={featured.length ? "#sessions" : sitePath("/sessions/")}
        >
          Explore sessions
        </a>
      </div>
    </div>
  </section>

  {(featured.length > 0 || featuredEvents.length > 0) && (
    <div class="panel paper">
      <div class="wrap home-offerings">
        {featured.length > 0 && (
          <section id="sessions" aria-labelledby="sessions-title" tabindex="-1">
            <div class="section-heading">
              <div>
                <h2 id="sessions-title">{content.sessionsHeading}</h2>
                <p>
                  {communalSession && recommendation ? (
                    <>
                      {sessionsIntroStart}
                      <a href={sitePath(`/sessions/${communalSession.id}/`)}>
                        {recommendation}
                      </a>
                      {sessionsIntroEnd}
                    </>
                  ) : (
                    content.sessionsIntro
                  )}
                </p>
              </div>
              <a class="text-link" href={sitePath("/sessions/")}>
                See all sessions
              </a>
            </div>
            <ul class="feature-grid" role="list">
              {featured.map(({ id, name, summary, image }) => (
                <FeatureCard
                  href={sitePath(`/sessions/${id}/`)}
                  headingId={
                    id === featured[0]?.id
                      ? "featured-session-title"
                      : `choice-${id}`
                  }
                  title={sessionComparison[id]?.displayName ?? name}
                  description={summary}
                  image={image}
                />
              ))}
            </ul>
          </section>
        )}
        <HomeEvents events={featuredEvents} />
      </div>
    </div>
  )}

  <section
    id="benefits"
    class="panel benefits-preview"
    aria-labelledby="benefits-title"
  >
    {content.benefitsBackground ? (
      <SanityPhoto
        class="benefits-backdrop"
        image={content.benefitsBackground}
        maxWidth={1600}
        sizes={benefitsImageSizes}
        quality={72}
        scrollReveal
      />
    ) : (
      <Image
        class="benefits-backdrop"
        src={saunaBenefitsPhoto}
        alt=""
        widths={[800, 960, 1200, 1440, 1600]}
        sizes={benefitsImageSizes}
        format="webp"
        quality={72}
        data-scroll-reveal
      />
    )}
    <div class="wrap">
      <div class="benefits-panel">
        <h2 id="benefits-title">Sauna benefits</h2>
        <ul class="benefit-highlights" role="list">
          {benefitHighlights.map(({ icon, title }) => (
            <li>
              <span class="benefit-highlight-icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d={benefitIcons[icon]} />
                </svg>
              </span>
              <span>{title}</span>
            </li>
          ))}
        </ul>
        <div class="actions">
          <a class="text-link" href={sitePath("/benefits/")}>
            Read more about benefits
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="panel" aria-labelledby="hosts-title" tabindex="-1">
    <div class="wrap editorial">
      <div class="photo hosts-photo" data-scroll-reveal>
        <SanityPhoto
          image={content.hostsPhoto}
          maxWidth={960}
          sizes="(max-width: 42rem) 90vw, 40vw"
        />
      </div>
      <div class="editorial-copy">
        <h2 id="hosts-title">{content.hostsHeading}</h2>
        <p>{content.hostsIntro}</p>
        <div class="actions">
          <a class="text-link" href={sitePath("/about/")}>
            Read their story
          </a>
        </div>
      </div>
    </div>
  </section>
  <HomeOpinions />
  <LocationMap variant="home-intro" background={content.visitBackground} />
</SiteLayout>
