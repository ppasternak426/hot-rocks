---
import { sitePath } from "../../data/site-path";
import EventCards from "../../components/EventCards.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getPublishedEvents } from "../../data/events";
import SiteLayout from "../../layouts/SiteLayout.astro";

const events = await getPublishedEvents();
const now = Date.now();
const upcoming = events.filter(({ startsAt }) => Date.parse(startsAt) >= now);
const past = events
  .filter(({ startsAt }) => Date.parse(startsAt) < now)
  .reverse();
---

<SiteLayout
  title="Events"
  description="Explore past and upcoming events at The Hot Rocks Sauna at Gawley’s Gate."
>
  <PageIntro
    title="Events at Hot Rocks"
    intro="See what’s coming up at Gawley’s Gate."
  />

  <section
    class="panel paper"
    id="upcoming-events"
    aria-labelledby="upcoming-title"
    tabindex="-1"
  >
    <div class="wrap">
      <div class="section-heading">
        <h2 id="upcoming-title">Upcoming events</h2>
      </div>
      {upcoming.length > 0 ? (
        <EventCards events={upcoming} />
      ) : (
        <>
          <p>There are no upcoming events listed right now.</p>
          <div class="actions mt-3">
            <a class="text-link" href={sitePath("/sessions/#guided-sessions")}>
              Explore guided rituals
            </a>
          </div>
        </>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="panel toast" aria-labelledby="past-title">
      <div class="wrap">
        <div class="section-heading">
          <h2 id="past-title">Past events</h2>
        </div>
        <EventCards events={past} />
      </div>
    </section>
  )}
</SiteLayout>
