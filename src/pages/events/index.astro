---
import EventCards from "../../components/EventCards.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getPublishedEvents } from "../../data/events";
import SiteLayout from "../../layouts/SiteLayout.astro";

const events = await getPublishedEvents();
---

<SiteLayout
  title="Events"
  description="Explore past and upcoming events at The Hot Rocks Sauna at Gawley’s Gate."
>
  <PageIntro
    title="Events at Hot Rocks"
    intro={
      events.length
        ? "Explore past and upcoming events at Gawley’s Gate."
        : "There are no events listed at the moment. You can still explore our guided rituals and sauna sessions."
    }
  >
    {events.length === 0 && (
      <div class="actions">
        <a class="button" href="/sessions/#rituals">
          Explore Guided Rituals
        </a>
      </div>
    )}
  </PageIntro>

  {events.length > 0 && (
    <section class="panel paper" aria-labelledby="events-title">
      <div class="wrap">
        <div class="section-heading">
          <h2 id="events-title">All events</h2>
        </div>
        <EventCards events={events} />
      </div>
    </section>
  )}
</SiteLayout>
