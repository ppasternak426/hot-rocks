---
import PageIntro from "../../components/PageIntro.astro";
import { formatEventDate, getPublishedEvents } from "../../data/events";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const events = await getPublishedEvents();
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
---

<SiteLayout title={event.title} description={event.description}>
  <PageIntro title={event.title} intro={event.description}>
    <p>
      <time datetime={event.startsAt}>{formatEventDate(event.startsAt)}</time>
    </p>
    <div class="actions">
      <a class="text-link" href="/events/">
        Back to Events
      </a>
      <a class="text-link" href="/visit/#contact">
        Ask About This Event
      </a>
    </div>
  </PageIntro>
  {event.image && (
    <div class="panel paper">
      <div class="wrap">
        <div
          class="event-detail-photo photo-corners"
          style={{
            "--event-image-width": `${event.image.width}px`,
            "--event-image-ratio": event.image.width / event.image.height,
          }}
        >
          <img
            src={`${event.image.url}?w=1152&h=832&fit=max&auto=format`}
            alt={event.image.alt}
            width={event.image.width}
            height={event.image.height}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  )}
</SiteLayout>

<style>
  .event-detail-photo {
    inline-size: min(
      100%,
      36rem,
      var(--event-image-width),
      calc(min(55svh, 26rem) * var(--event-image-ratio))
    );
  }

  .event-detail-photo img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
